# Generate a long random value before deployment.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=1

# Keep SQLite for local development. For production, use managed PostgreSQL/MySQL.
DATABASE_URL=sqlite:///skillforge_ai.sqlite3
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
RATELIMIT_STORAGE_URI=memory://

# Model provider selection: openai-compatible or anthropic
LLM_PROVIDER=openai-compatible
# OpenAI-compatible: https://api.openai.com/v1, https://api.groq.com/openai/v1,
# or local Ollama: http://127.0.0.1:11434/v1
# Native Anthropic: https://api.anthropic.com/v1 (set LLM_PROVIDER=anthropic)
LLM_BASE_URL=https://api.openai.com/v1
ANTHROPIC_VERSION=2026-10-21
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TEMPERATURE=0.4
MAX_USER_MESSAGE_CHARS=12000
MAX_HISTORY_MESSAGES=20
DAILY_CHAT_LIMIT=30
